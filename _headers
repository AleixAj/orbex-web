# Cloudflare Pages / Netlify headers
# HTML: sin caché largo (podemos redeployar cambios de copy)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/
  Cache-Control: public, max-age=0, must-revalidate

/privacy
  Cache-Control: public, max-age=0, must-revalidate

# app-ads.txt: sin caché. Es lo que AdMob rastrea para verificar la app, y
# añadir una red de anuncios mañana tiene que propagarse ya, no en 24 h.
/app-ads.txt
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/plain

# Imágenes: cache largo (fingerprint en el nombre si cambian)
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

# Fuentes: cache largo (mismo criterio que las imagenes)
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Videos
/assets/videos/*
  Cache-Control: public, max-age=31536000, immutable
